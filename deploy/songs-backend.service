[Unit]
Description=Songs Backend API
After=network.target

[Service]
Type=simple
User=songs
Group=songs
WorkingDirectory=/srv/apps/songs-backend
EnvironmentFile=/srv/apps/songs-backend/.env
ExecStart=/srv/apps/songs-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
