[Unit]
Description=Songs Backend API
After=network.target

[Service]
Type=simple
User=songs
Group=songs
WorkingDirectory=/srv/apps/songs-backend
EnvironmentFile=-/srv/apps/songs-backend/.env
Environment=RELOAD=0
ExecStart=/srv/apps/songs-backend/scripts/run-backend.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
