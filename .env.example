# SQLite file relative to the backend directory
DATABASE_URL=sqlite:///./songs.db

# Port the FastAPI backend listens on
PORT=7333

# Comma-separated list of allowed origins for the REST API
SONGS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional regex for additional origins (leave empty to disable)
# SONGS_API_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$

# How hard the API insists on a session: required | optional | disabled.
# `required` denies everything except app/auth/policy.py's PUBLIC_ROUTES.
SONGS_API_AUTH_MODE=required

# The session cookie is `Secure` by default, and a browser drops a Secure
# cookie sent over plain http — so local development has to turn it off.
# Never set this on a deployment served over https.
SONGS_API_SESSION_COOKIE_SECURE=0
