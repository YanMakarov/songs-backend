# SQLite file relative to the backend directory
DATABASE_URL=sqlite:///./songs.db

# Comma-separated list of allowed origins for the REST API
SONGS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional regex for additional origins (leave empty to disable)
# SONGS_API_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
